<script>
const CSRF_TOKEN = <?= json_encode($varIni['csrf_token'] ?? ''); ?>;
const PLUGIN_NAME = <?= json_encode($pluginName); ?>;
function appdatasyncInitError(msg) {
  const badge = document.getElementById('adbStatusBadge');
  if (badge) {
    badge.textContent = 'Error';
    badge.className = 'adb-status-badge failed';
  }
  const meta = document.getElementById('adbStatusMeta');
  if (meta) meta.textContent = msg;
  console.error(msg);
}
window.addEventListener('error', function (e) {
  if (e.target && (e.target.tagName === 'SCRIPT' || e.target.tagName === 'LINK')) {
    appdatasyncInitError('Failed to load plugin asset: ' + (e.target.src || e.target.href));
  }
});
window.onerror = function (msg) {
  appdatasyncInitError('JavaScript error: ' + msg);
};
// Fallback if the external script never initializes within 8 seconds.
setTimeout(function () {
  const badge = document.getElementById('adbStatusBadge');
  if (badge && badge.textContent === 'Loading…') {
    appdatasyncInitError('Plugin script did not initialize. Check that /plugins/appdatasync/appdatasync.js is accessible.');
  }
}, 8000);
</script>
<script src="/plugins/appdatasync/appdatasync.js" onerror="appdatasyncInitError('Failed to load appdatasync.js')"></script>
