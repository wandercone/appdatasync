# Path where all backups will be stored.
backup_destination: /mnt/user/backup/appdata

# Whether to organize backups into subfolders based on groups (e.g., group-1, group-2).
store_by_group: yes

# Optional global hooks run before/after the entire operation.
# Paths must be absolute. Non-zero exit aborts the run and marks it failed.
hooks:
  pre_run: /boot/config/plugins/appdatasync/hooks/pre-run.sh
  post_run: /boot/config/plugins/appdatasync/hooks/post-run.sh

# Host profiles. SSH credentials and the default container runtime defined here
# are inherited by containers unless a container enables ssh_override or sets its
# own runtime. The "local" host is always available and has no SSH settings.
hosts:
  - name: local
  - name: my-server
    ssh_user: userName
    ssh_key: /mnt/user/system/keys/ssh_key
    ssh_port: 22
    runtime: docker  # Default runtime for containers on this host: docker or podman

# Definition of backup groups
groups:
  group-1:
    # Optional group-level hooks run before/after this group.
    # Global pre_run runs first, then this group's pre_group, then the group backup,
    # then this group's post_group, then global post_run.
    hooks:
      pre_group: /boot/config/plugins/appdatasync/hooks/group-1-pre.sh
      post_group: /boot/config/plugins/appdatasync/hooks/group-1-post.sh

    # First container in group-1
    - name: container-a  # Name of the container
      host: local  # Container is running on the local machine
      appdata_path: /mnt/user/appdata/container-a  # Path to the container's appdata/config directory
      restart: yes  # Stop/Start the container for the backup operation
      start_delay: 10 # Wait (in seconds) before starting this container. Helpful if a dependent container needs time to init

    # Second container in group-1, inherits the host's runtime (docker by default)
    - name: container-b
      host: local
      appdata_path: /mnt/user/appdata/container-b
      restart: no

    # Third container in group-1, overrides the host's default runtime
    - name: container-e
      host: local
      runtime: podman  # Only needed when overriding the host's default runtime
      appdata_path: /mnt/user/appdata/container-e
      restart: yes

  group-2:
    # First container in group-2, hosted on the remote "my-server" host profile
    - name: container-c
      host: my-server  # References the host profile above
      appdata_path: /docker/container-c  # Appdata path on the remote server
      restart: yes

    # Second container in group-2, also on "my-server", with a one-off SSH override
    - name: container-d
      host: my-server
      ssh_override: yes
      ssh_user: otherUser
      ssh_key: /mnt/user/system/keys/other_key
      ssh_port: 2222
      appdata_path: /docker/container-d
      restart: yes
