<FILE Name="/boot/config/plugins/appdatasync/appdatasync-2026.07.27_rc6-noarch-1.txz">
<URL>https://github.com/wandercone/appdatasync/releases/download/2026.07.27_rc6/appdatasync-2026.07.27_rc6-noarch-1.txz</URL>
<SHA256>5bfded2eef1d176d6b0160ae742db54973f3e2c099d9e839639a331dc020939b</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/appdatasync/appdatasync.cron">
<INLINE>
# Generated appdatasync plugin scheduled tasks
# Disable/enable and change schedule from the plugin settings page
</INLINE>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/appdatasync/appdatasync-2026.07.27_rc6-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/appdatasync/appdatasync-*.txz 2>/dev/null | grep -v '2026.07.27_rc6')

# ensure plugin config directory exists on /boot so user config survives updates
mkdir -p /boot/config/plugins/appdatasync

# copy the default/example config if no user config exists yet
if [[ ! -f /boot/config/plugins/appdatasync/config.yaml ]]; then
    cp /usr/local/emhttp/plugins/appdatasync/config.yaml.example /boot/config/plugins/appdatasync/config.yaml
fi

# ensure python dependencies are present
if command -v python3 >/dev/null 2>&1; then
    python3 -m pip install -r /usr/local/emhttp/plugins/appdatasync/requirements.txt >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "Warning: failed to install Python dependencies from requirements.txt"
        echo "          You may need to run: python3 -m pip install -r /usr/local/emhttp/plugins/appdatasync/requirements.txt"
    fi
else
    echo "Warning: python3 not found. Python dependencies were not installed."
fi

# regenerate the plugin-owned cron file from saved state (also recreates it on boot)
/usr/bin/php /usr/local/emhttp/plugins/appdatasync/include/cron.php --install-cron 2>/dev/null || true

# sync the plugin-owned cron file into the running cron state
/usr/local/sbin/update_cron

echo ""
echo "----------------------------------------------------"
echo " appdatasync has been installed."
echo " Version: 2026.07.27_rc6"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg appdatasync

rm -rf /usr/local/emhttp/plugins/appdatasync
rm -rf /boot/config/plugins/appdatasync

# sync removal into the running cron state
/usr/local/sbin/update_cron
]]>
</INLINE>
</FILE>

</PLUGIN>
